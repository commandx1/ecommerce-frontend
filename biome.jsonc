{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // Generated run artefacts, not source - linting them fails `biome check .` after a run.
    // - test-results / playwright-report: Playwright traces, .last-run.json, html report.
    // - .stryker-tmp: Stryker copies the whole project (including this file) into per-run
    //   sandboxes; Biome then reports "nested root configuration" and exits non-zero. A killed
    //   or crashed mutation run leaves these behind, so the gate must not depend on cleanup.
    //   The glob is deliberate: a run can be pointed at its own temp dir (.stryker-tmp-<name>)
    //   to avoid colliding with a concurrent one, and those must be ignored too.
    // - reports: mutation HTML/JSON output; the JSON alone exceeds Biome's 1 MiB file limit.
    "includes": ["**", "!test-results", "!playwright-report", "!.stryker-tmp*", "!reports"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "bracketSameLine": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // TECHNICAL DEBT — the "warn" entries below are deliberate, not permanent.
      // They are broad/stylistic rules with a large existing violation count in src/;
      // fixing them all at once would carry real regression risk. They stay visible as
      // warnings (CI stays green) and are meant to be driven to zero and flipped back to
      // "error" incrementally, one rule at a time.
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "warn",
        "noConsole": "warn",
        "noArrayIndexKey": "warn",
        "noDocumentCookie": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": "warn",
        "noConstAssign": "error",
        "useUniqueElementIds": "warn",
        "noUnusedFunctionParameters": "warn"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "noUselessFragments": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "useTemplate": "warn"
      },
      "a11y": {
        "useKeyWithClickEvents": "off"
      }
    }
  },
  // public/ holds static assets served verbatim, including the vendored upstream QZ Tray
  // connector (public/qz-tray.js, LGPL-2.1, pulled in at runtime via <script src>, never
  // bundled or type-checked). Linting it only produces noise about upstream style, and
  // patching it in place would break the upgrade path, so it is excluded here.
  "overrides": [
    {
      "includes": ["public/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Vendor-dashboard boundary (design doc §1, §S11, Phase 4 §7 C1): `features/vendor-dashboard/**`
      // must not import from `app/vendor-dashboard/**` at all. The former carve-out,
      // `components/shared/{DashboardPanel,dashboardToneMaps}`, moved to
      // `components/dashboard-shared/` in Phase 4 (C1), so there is no exception any more.
      "includes": ["src/features/vendor-dashboard/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/vendor-dashboard/**"],
                    "message": "features/vendor-dashboard must not import from app/vendor-dashboard."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Phase 4 buyer-dashboard boundary (design doc §1, §7, B1-B5): `features/buyer-dashboard/**`
      // must not import from `app/buyer-dashboard/**`. Unlike vendor's S11 boundary, there is no
      // carve-out - every shared piece the buyer side used to reach into `app/` for already moved
      // to `components/`, `lib/` or `features/` earlier in Phase 4.
      "includes": ["src/features/buyer-dashboard/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/buyer-dashboard/**"],
                    "message": "features/buyer-dashboard must not import from app/buyer-dashboard."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  }
}
