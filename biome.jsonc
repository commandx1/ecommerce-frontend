{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // Generated run artefacts, not source - linting them fails `biome check .` after a run.
    // - test-results / playwright-report: Playwright traces, .last-run.json, html report.
    // - .stryker-tmp: Stryker copies the whole project (including this file) into per-run
    //   sandboxes; Biome then reports "nested root configuration" and exits non-zero. A killed
    //   or crashed mutation run leaves these behind, so the gate must not depend on cleanup.
    //   The glob is deliberate: a run can be pointed at its own temp dir (.stryker-tmp-<name>)
    //   to avoid colliding with a concurrent one, and those must be ignored too.
    // - reports: mutation HTML/JSON output; the JSON alone exceeds Biome's 1 MiB file limit.
    "includes": ["**", "!test-results", "!playwright-report", "!.stryker-tmp*", "!reports"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "bracketSameLine": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // TECHNICAL DEBT — the "warn" entries below are deliberate, not permanent.
      // They are broad/stylistic rules with a large existing violation count in src/;
      // fixing them all at once would carry real regression risk. They stay visible as
      // warnings (CI stays green) and are meant to be driven to zero and flipped back to
      // "error" incrementally, one rule at a time.
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "error",
        // Every remaining call site is deliberate error-path logging (console.error/warn in a
        // catch block, no debug logs). Allow those two methods explicitly instead of building a
        // logging abstraction just for this; console.log/debug/etc. are still disallowed.
        "noConsole": {
          "level": "error",
          "options": { "allow": ["error", "warn"] }
        },
        "noArrayIndexKey": "error",
        "noDocumentCookie": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": "error",
        "noConstAssign": "error",
        "useUniqueElementIds": "warn",
        "noUnusedFunctionParameters": "error"
      },
      "complexity": {
        "useOptionalChain": "error",
        "noUselessFragments": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "useTemplate": "error"
      },
      "a11y": {
        "useKeyWithClickEvents": "off"
      }
    }
  },
  // public/ holds static assets served verbatim, including the vendored upstream QZ Tray
  // connector (public/qz-tray.js, LGPL-2.1, pulled in at runtime via <script src>, never
  // bundled or type-checked). Linting it only produces noise about upstream style, and
  // patching it in place would break the upgrade path, so it is excluded here.
  "overrides": [
    {
      "includes": ["public/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      // Whole-tree features/app boundary (design doc §1, §7, Z), generalized from the separate
      // vendor-dashboard (S11) and buyer-dashboard (B1-B5) rules that grew up during Phase 4:
      // `src/features/**` must not import from `@/app/**` at all. Every shared piece any feature
      // used to reach into `app/` for (order leaves, the auth guard, panel/tone-map primitives,
      // account-settings components) has moved to `components/`, `lib/` or `features/`, so there
      // is no exception left. See `src/features/architecture.test.ts` for the harder-to-fool,
      // whole-tree backstop that doesn't depend on this config staying correct.
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "features/** must not import from app/**."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  }
}
