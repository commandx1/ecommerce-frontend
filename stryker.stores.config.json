{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.jsdom.config.mts"
  },
  "mutate": ["src/stores/authStore.ts", "src/stores/cartStore.ts", "src/stores/checkoutStore.ts"],
  "concurrency": 4,
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/stores/index.html"
  },
  "timeoutMS": 60000
}
